@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    scroll-behavior: smooth;
  }

  body {
    @apply bg-sand-50 text-charcoal-800;
    font-feature-settings: "kern" 1, "liga" 1;
  }

  ::selection {
    @apply bg-terracotta-200 text-terracotta-900;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    @apply bg-sand-100;
  }

  ::-webkit-scrollbar-thumb {
    @apply bg-clay-400 rounded-full;
  }

  ::-webkit-scrollbar-thumb:hover {
    @apply bg-clay-500;
  }
}

@layer components {
  .btn-primary {
    @apply bg-terracotta-500 hover:bg-terracotta-600 text-white font-semibold 
           px-6 py-3 rounded-2xl transition-all duration-300 ease-out
           active:scale-95 active:bg-terracotta-700
           shadow-clay hover:shadow-lg
           disabled:opacity-50 disabled:cursor-not-allowed;
  }

  .btn-secondary {
    @apply bg-sand-200 hover:bg-sand-300 text-charcoal-700 font-semibold
           px-6 py-3 rounded-2xl transition-all duration-300 ease-out
           active:scale-95 active:bg-sand-400
           border border-sand-300;
  }

  .btn-olive {
    @apply bg-olive-500 hover:bg-olive-600 text-white font-semibold
           px-6 py-3 rounded-2xl transition-all duration-300 ease-out
           active:scale-95 active:bg-olive-700
           shadow-soft hover:shadow-lg;
  }

  .card-luxury {
    @apply bg-white/80 backdrop-blur-sm rounded-3xl shadow-soft-lg
           border border-sand-200/60 overflow-hidden
           transition-all duration-500 hover:shadow-clay hover:-translate-y-1;
  }

  .input-luxury {
    @apply bg-sand-50 border-2 border-sand-200 rounded-2xl px-4 py-3
           text-charcoal-800 placeholder:text-charcoal-400
           focus:border-terracotta-400 focus:ring-2 focus:ring-terracotta-200
           focus:outline-none transition-all duration-300
           hover:border-sand-300;
  }

  .glass-panel {
    @apply bg-white/70 backdrop-blur-md rounded-3xl 
           border border-white/40 shadow-soft-lg;
  }

  .text-gradient-terracotta {
    @apply bg-gradient-to-r from-terracotta-600 to-ocher-500 bg-clip-text text-transparent;
  }

  .section-padding {
    @apply px-4 sm:px-6 lg:px-8 xl:px-12 2xl:px-16;
  }

  .animate-clay-press {
  @apply transition-all duration-200 ease-out active:scale-95 active:shadow-inner;
  }
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
}
